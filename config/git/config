[alias]
	a = "add"
	aa = "add --all"
	ap = "add --patch"
	c = "commit -m"
	ca = "commit --amend"
	ci = "commit -v"
	co = "checkout"
	di = "diff"
	dic = "diff --cached"
	l = "log --graph --abbrev-commit --decorate --all --date=relative --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)'"
	out = "log origin..HEAD"
	pl = "pull"
	plre = "pull --rebase"
	ps = "push"
	st = "status"
	up = "!git fetch origin && git rebase origin/main"

[color]
	ui = "auto"

[core]
	autocrlf = "input"
	quotepath = "false"

[credential "https://github.com"]
	helper =
	helper = "!gh auth git-credential"

[init]
	defaultBranch = "main"

[mergetool]
	keepBackup = "false"

[pull]
	rebase = "true"

[push]
	default = "current"

[user]
	email = "jon@suderman.net"
	name = "Jon Suderman"
