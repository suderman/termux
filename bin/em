#!/data/data/com.termux/files/usr/bin/bash
# Termux port of the NixOS em launcher: a terminal frame on one Emacs daemon
# per tmux session, or on the default daemon outside tmux. Daemons start on
# demand, survive disconnecting the client, and stop with their tmux session.
set -euo pipefail

# tmux reuses session IDs after its server restarts. The boot ID and server
# PID keep a surviving daemon from being mistaken for a new session's.
daemon_name() {
  local socket=$1 server=$2 boot hash
  boot=$(</proc/sys/kernel/random/boot_id)
  hash=$(printf '%s\n' "$boot:$socket:$server" | sha256sum)
  echo "em-${hash:0:24}"
}

# Nothing is left to prompt in, so auto-save unsaved buffers before exiting.
# Only session daemons qualify; an empty name would reach the default server.
stop_daemon() {
  [[ $1 == em-* ]] || return 0
  emacsclient -s "$1" -e '(progn (do-auto-save t) (kill-emacs))' >/dev/null 2>&1 || true
}

case ${1-} in
--stop-tmux)
  # tmux session-closed hook: SOCKET SERVER_PID SESSION_ID
  name=$(daemon_name "$2" "$3:$4")
  stop_daemon "$name"
  exit
  ;;
--watch-tmux)
  # tmux runs no hook when its last pane exits, so follow the server: PID NAME.
  # Stop watching once the daemon exits, such as through the session hook.
  daemon=$(emacsclient -s "$3" -e '(emacs-pid)')
  while kill -0 "$2" 2>/dev/null; do
    kill -0 "$daemon" 2>/dev/null || exit 0
    sleep 10
  done
  stop_daemon "$3"
  exit
  ;;
esac

[[ $# -gt 0 ]] || set -- .

state=${XDG_STATE_HOME:-$HOME/.local/state}
name=server
log=$state/emacs/startup.log
frame=()
server_pid=

if [[ -n ${TMUX_PANE-}${TMUX-} ]]; then
  [[ -n ${TMUX_PANE-} && -n ${TMUX-} ]] || {
    echo 'em: tmux pane or socket is missing' >&2
    exit 1
  }
  socket=${TMUX%%,*}
  server=$(tmux display-message -p -t "$TMUX_PANE" '#{pid}:#{session_id}') || {
    echo "em: cannot resolve tmux session for pane $TMUX_PANE" >&2
    exit 1
  }
  server_pid=${server%%:*}
  name=$(daemon_name "$socket" "$server")
  # Keep history, autosaves, and backups per daemon, as on NixOS.
  state=$state/emacs-workspaces/$name
  log=$state/startup.log
  frame=(-F "((edger-tmux-pane-id . \"$TMUX_PANE\") (edger-tmux-socket . \"$TMUX\"))")
fi

if ! emacsclient -s "$name" -e t >/dev/null 2>&1; then
  exec 9>"${TMPDIR:-/tmp}/$name.lock"
  flock 9
  if ! emacsclient -s "$name" -e t >/dev/null 2>&1; then
    [[ $name == server ]] || export XDG_STATE_HOME=$state
    install -d -m 700 "${log%/*}"
    if ! emacs --daemon="$name" >"$log" 2>&1; then
      cat "$log" >&2
      exit 1
    fi
    if [[ -n $server_pid ]]; then
      setsid -f "$0" --watch-tmux "$server_pid" "$name" </dev/null >/dev/null 2>&1 9>&-
    fi
  fi
  flock -u 9
  exec 9>&-
fi

exec emacsclient -s "$name" --tty "${frame[@]}" "$@"
